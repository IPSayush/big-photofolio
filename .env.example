# ============================================================
# PhotoFolio — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- General ---
NODE_ENV=development
PORT=5000

# --- MongoDB (Atlas) ---
MONGODB_URI=mongodb+srv://lakshminama59_db_user:gUQEzUQuAX7Dq2TZ@2-clust.w5bvvgk.mongodb.net/?appName=2-clust

# --- Redis (for BullMQ + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AWS S3 ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAWUZKOWFQ4RQIXGUO
AWS_SECRET_ACCESS_KEY=5uAlFoPK0Ah4yUO2otdYIEZA3Mkz7Nr7bFLiNROp
S3_BUCKET_ORIGINALS=photofolio-originals-ayush-2026
S3_BUCKET_DERIVATIVES=photofolio-derivatives-ayush-2026

# --- AWS CloudFront ---
CLOUDFRONT_DOMAIN=https://dxxxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=your-key-pair-id
CLOUDFRONT_PRIVATE_KEY_PATH=./cloudfront-private-key.pem

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Email (SES / SMTP) ---
EMAIL_PROVIDER=ses
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@photofolio.app

# --- App URLs ---
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Upload (FR-UPLOAD-004, NFR-MAINT-001) ---
MAX_FILE_SIZE_BYTES=52428800
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/heic,image/heif
PRESIGNED_URL_EXPIRES_IN=900
MAX_UPLOAD_BATCH_SIZE=100

# --- Image Processing (FR-PIPE-002, NFR-MAINT-001) ---
DERIVATIVE_THUMBNAIL_WIDTH=300
DERIVATIVE_THUMBNAIL_QUALITY=80
DERIVATIVE_WEB_MAX_WIDTH=1920
DERIVATIVE_WEB_QUALITY=85
DERIVATIVE_WATERMARK_ENABLED=true
DERIVATIVE_WATERMARK_TEXT=PhotoFolio
DERIVATIVE_WATERMARK_OPACITY=0.3
DERIVATIVE_WATERMARK_FONT_SIZE=48

# --- Worker ---
WORKER_CONCURRENCY=3

# --- Face Detection (GAP-019, FR-MATCH-002) ---
FACE_PROVIDER=mock
FACE_MATCH_THRESHOLD=0.6
